// Zero to Dev - CS & Cybersecurity Mastery Platform
// PostgreSQL schema via Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH & USERS
// ============================================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  username      String   @unique
  passwordHash  String
  avatarUrl     String?
  xpTotal       Int      @default(100)
  currentPhase  Int      @default(1)
  streak        Int      @default(0)
  lastActiveAt  DateTime @default(now())
  role          String   @default("student") // student, admin
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  progress      UserProgress[]
  attempts      UserExerciseAttempt[]
  labSessions   LabSession[]
  achievements  UserAchievement[]
  projectSubmissions ProjectSubmission[]
  assessmentAttempts AssessmentAttempt[]
  interviewAttempts  InterviewAttempt[]
  portfolioArtifacts PortfolioArtifact[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// LEARNING CONTENT
// ============================================================

model Phase {
  id          String @id @default(cuid())
  number      Int    @unique
  title       String
  description String
  icon        String // lucide icon name

  lessons Lesson[]
}

model Lesson {
  id          String   @id @default(cuid())
  phaseId     String
  title       String
  slug        String   @unique
  description String
  contentMdx  String
  order       Int
  xpReward    Int      @default(50)
  category    String   // "cs" or "cyber"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  phase       Phase    @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  exercises   Exercise[]
  progress    UserProgress[]
  projects    Project[]

  @@unique([phaseId, order])
}

model Exercise {
  id          String   @id @default(cuid())
  lessonId    String
  title       String
  slug        String   @unique
  description String
  starterCode String
  language    String   @default("python")
  order       Int
  xpReward    Int      @default(25)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  hints       Hint[]
  testCases   TestCase[]
  attempts    UserExerciseAttempt[]
  exploitTargetId String?
  exploitTarget   Exercise? @relation("ExploitTarget", fields: [exploitTargetId], references: [id])
  exploitedBy     Exercise[] @relation("ExploitTarget")

  @@unique([lessonId, order])
}

model Hint {
  id         String @id @default(cuid())
  exerciseId String
  level      Int    // 1=Nudge, 2=Approach, 3=Near Answer
  content    String
  xpCost     Int    // 5, 10, 20

  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, level])
}

model TestCase {
  id           String  @id @default(cuid())
  exerciseId   String
  input        String
  expectedOutput String
  isHidden     Boolean @default(false)
  order        Int

  exercise     Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}

// ============================================================
// USER PROGRESS & GAMIFICATION
// ============================================================

model UserProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completed   Boolean  @default(false)
  completedAt DateTime?
  hintsUsed   Int      @default(0)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model UserExerciseAttempt {
  id           String   @id @default(cuid())
  userId       String
  exerciseId   String
  code         String
  passed       Boolean
  output       String?
  attemptNum   Int
  hintsUsed    Int      @default(0)
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise     Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId, attemptNum])
}

model Achievement {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  description String
  icon        String
  xpBonus     Int    @default(0)
  category    String // "cs", "cyber", "streak", "social"

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement  Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

// ============================================================
// HACKING LABS (CTF)
// ============================================================

model HackingLab {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  description     String
  phase           Int
  difficulty      String   // "easy", "medium", "hard", "expert"
  category        String   // "web", "crypto", "forensics", "reversing", "pwn", "encoding", "scripting", "binary"
  expectedFlag    String
  setupMdx        String   @default("")  // Setup instructions (markdown)
  toolsHint       String   @default("")  // Tools needed hint
  briefingMdx     String   @default("")  // Full briefing/story
  author          String   @default("Zero to Dev")  // Challenge author
  labUrl          String?
  downloadUrl     String?
  xpReward        Int      @default(100)
  hintContent     String?
  solutionUrl     String?
  order           Int
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions        LabSession[]
}

model LabSession {
  id          String   @id @default(cuid())
  userId      String
  labId       String
  submittedFlag String?
  solved      Boolean  @default(false)
  attempts    Int      @default(0)
  startedAt   DateTime @default(now())
  solvedAt    DateTime?

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lab         HackingLab @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@unique([userId, labId])
}

// ============================================================
// PROJECTS (Portfolio Artifacts)
// ============================================================

model Project {
  id          String   @id @default(cuid())
  lessonId    String
  title       String
  slug        String   @unique
  description String
  brief       String   @default("")
  rubric      String   @default("{}")
  starterRepo String?
  order       Int
  xpReward    Int      @default(200)
  category    String   @default("cs")
  createdAt   DateTime @default(now())

  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions ProjectSubmission[]

  @@unique([lessonId, order])
}

model ProjectSubmission {
  id          String   @id @default(cuid())
  userId      String
  projectId   String
  repoUrl     String
  description String?
  status      String   @default("pending")
  score       Int?
  feedback    String?
  submittedAt DateTime @default(now())
  reviewedAt  DateTime?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

// ============================================================
// ASSESSMENTS (Ready-Check)
// ============================================================

model Assessment {
  id          String   @id @default(cuid())
  phaseNumber Int
  title       String
  slug        String   @unique
  description String
  timeLimit   Int      @default(30)
  passScore   Int      @default(70)
  order       Int
  isRequired  Boolean  @default(true)
  createdAt   DateTime @default(now())

  problems    AssessmentProblem[]
  attempts    AssessmentAttempt[]
}

model AssessmentProblem {
  id            String   @id @default(cuid())
  assessmentId  String
  title         String
  type          String   @default("coding")
  description   String
  starterCode   String?
  language      String?
  testCases     String?
  correctAnswer String?
  points        Int      @default(10)
  order         Int

  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

model AssessmentAttempt {
  id            String   @id @default(cuid())
  userId        String
  assessmentId  String
  startedAt     DateTime @default(now())
  submittedAt   DateTime?
  score         Int?
  passed        Boolean?
  answers       String   @default("{}")

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([userId, assessmentId])
}

// ============================================================
// INTERVIEW PREP
// ============================================================

model InterviewProblem {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  difficulty  String   @default("easy")
  category    String   @default("arrays")
  description String
  starterCode String
  language    String   @default("python")
  testCases   String   @default("[]")
  hints       String?
  solution    String
  xpReward    Int      @default(50)
  pattern     String?
  createdAt   DateTime @default(now())

  attempts    InterviewAttempt[]
}

model InterviewAttempt {
  id          String   @id @default(cuid())
  userId      String
  problemId   String
  code        String
  passed      Boolean
  timeSpent   Int      @default(0)
  hintsUsed   Int      @default(0)
  attemptNum  Int
  createdAt   DateTime @default(now())

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem     InterviewProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

// ============================================================
// PORTFOLIO
// ============================================================

model PortfolioArtifact {
  id          String   @id @default(cuid())
  userId      String
  type        String
  title       String
  description String
  url         String?
  sourceId    String
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, sourceId])
}
